<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The window before Compose draws: the same deep walnut as the game, so launch never flashes white. -->
    <style name="Theme.Tilt" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/walnut</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
